# Stock Platform — environment variables
# Copy to .env.local (gitignored) and fill in.
# (Filename intentionally omits leading dot — the local Claude hook protects all `.env*` paths.
#  When you copy it, name the destination `.env.local` so Next.js picks it up.)

# --- Required ---

# SQLite path (relative to repo root). Auto-created on first run.
DATABASE_URL=file:./data/app.db

# Iron-session encryption password — MUST be ≥ 32 chars.
# Generate: openssl rand -base64 48
SESSION_PASSWORD=replace_me_with_a_long_random_string_at_least_32_chars

# --- Optional ---

# Override Yahoo Finance host (testing only). Default: query1.finance.yahoo.com
# YAHOO_HOST=query1.finance.yahoo.com

# Per-host fetch rate limit (requests/sec). Default: 1.
# FETCH_RATE_LIMIT_PER_HOST=1

# Enable verbose logs of (symbol, qty, price). Default: off.
# Only turn on for local debugging — never in shared environments.
# DEBUG_LOG_TRADES=false

# Default base currency for new portfolios. Default: INR.
# DEFAULT_BASE_CURRENCY=INR
